# Backend API Base URL
# Default local development URL (leave empty or set to http://localhost:8000)
VITE_API_BASE_URL=http://localhost:8000

# For remote / mobile testing with Cloudflare Quick Tunnel:
# VITE_API_BASE_URL=https://<your-backend-tunnel>.trycloudflare.com
