# ==============================================================================
# MINDFUL METRICS FRONTEND ENVIRONMENT TEMPLATE
# Copy this file to .env.local for local overrides.
# NEVER commit real credentials or private tunnel endpoints to version control.
# ==============================================================================

# Backend API Base URL
# - Local development: http://localhost:8000
# - Production (Render): https://mindful-metrics-api.onrender.com (or with /api)
# Note: The frontend automatically normalizes URLs configured with or without trailing '/api'.
VITE_API_BASE_URL=http://localhost:8000

# For remote / mobile testing with Cloudflare Quick Tunnel:
# VITE_API_BASE_URL=https://<your-backend-tunnel>.trycloudflare.com
