# ==============================================================================
# MINDFUL METRICS BACKEND ENVIRONMENT TEMPLATE
# Copy this file to .env and configure values before starting the backend server.
# NEVER commit real .env files to version control.
# ==============================================================================

# Database Connection URL (PostgreSQL / Supabase or local SQLite)
DATABASE_URL=sqlite:///./mindful_metrics.db
# DATABASE_URL=postgresql://postgres:[YOUR_PASSWORD]@[YOUR_HOST]:5432/postgres

# Application Environment (development | production)
ENVIRONMENT=development

# JWT Secret Key (HMAC-SHA256)
# Minimum 32 bytes required in production for cryptographic security.
# Generate via: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=replace-with-a-secure-32-byte-hex-string-for-production-use

# Application Network URLs
BACKEND_URL=http://localhost:8000
FRONTEND_URL=http://localhost:5173
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://*.trycloudflare.com

# AI/ML Model Artifact Path & Burnout Risk Thresholds
MODEL_PATH=./models/burnout_random_forest.joblib
RISK_LOW_MAX=39
RISK_MOD_MAX=69

# Google Gemini API Key (Optional: Falls back to offline semantic/intent engine if empty)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-lite-latest
